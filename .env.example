# คัดลอกไฟล์นี้เป็น .env แล้วใส่ค่าจริง — ห้าม commit .env ขึ้น git
# บน Render ให้ใส่ค่าพวกนี้ในหน้า Environment ของ service แทน

# MongoDB Atlas — เอาจากปุ่ม Connect > Drivers
DATABASE_URI=mongodb+srv://USER:PASSWORD@cluster.xxxxx.mongodb.net/roombooking?retryWrites=true&w=majority

# ความลับสำหรับเซ็น token — สุ่มคนละค่า ห้ามใช้ค่าตัวอย่างนี้
# สร้างด้วย: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
ACCESS_TOKEN_SECRET=
REFRESH_TOKEN_SECRET=

# URL ของ frontend ที่อนุญาตให้เรียก API คั่นด้วย , ถ้ามีหลายอัน
# ตอน dev: http://localhost:5173
# ตอน production: https://ชื่อโปรเจค.vercel.app
ALLOWED_ORIGINS=http://localhost:5173

# ตั้งเป็น production บน Render เท่านั้น — ตัวนี้เป็นตัวสั่งให้ cookie เป็น secure + sameSite=none
NODE_ENV=development
